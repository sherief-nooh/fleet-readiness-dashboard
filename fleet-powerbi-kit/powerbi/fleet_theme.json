  "background": "#FFFFFF",
  "foreground": "#15202A",
  "tableAccent": "#1F3A4D",
  "good": "#2F6B4A",
  "neutral": "#C9771A",
  "bad": "#B42318",
  "maximum": "#1F6FB2",
  "center": "#F6E3A1",
  "minimum": "#F1F3F5",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#15202A" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#15202A" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#55636F" },
